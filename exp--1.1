# Experiment 1.1 Conatain duplicate (leetcode-217)

# // Aim:-
# // To write a C++ program that checks whether an integer array contains any duplicate elements. If any element appears more than once, return true; otherwise, return false.

# // Algorithm (Using Sorting)

# // Start.
# // Sort the given array in ascending order.
# // Traverse the sorted array from index 0 to n-2.
# // Compare each element with its next element.
# // If nums[i] == nums[i+1], return True (duplicate found).
# // If no duplicate is found after the loop, return False.
# // Stop.

# // Code:-
class Solution:
    def containsDuplicate(self, nums):
        nums.sort()
        n = len(nums)
        for i in range(n - 1):
            if nums[i] == nums[i + 1]:
                return True
        return False


# Test
if __name__ == "__main__":
    sol = Solution()
    nums = [1, 2, 3, 1]
    print(sol.containsDuplicate(nums))   # Output: True
